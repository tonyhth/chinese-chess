    "game.perpetualCheckMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Chinese Chess, perpetual check (3+ consecutive checks) is a loss for the checking side. The same applies to perpetual chase. This rule follows official Xiangqi tournament regulations."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中国象棋规则：连续将军（3个完整回合）判将军方负，连续捉子同理。此规则遵循正式比赛规则。"
          }
        }
      }
    },
