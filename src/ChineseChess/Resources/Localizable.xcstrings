        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          },
          "substitutions": {
            "%lld": {
              "choices": [
                {
                  "stringUnit": {
                    "state": "translated",
                    "value": "一"
                  }
                },
                {
                  "stringUnit": {
                    "state": "translated",
                    "value": "二"
                  }
                },
                {
                  "stringUnit": {
                    "state": "translated",
                    "value": "三"
                  }
                },
