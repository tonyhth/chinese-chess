    "tutorial.0.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "棋子走法"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Piece Movements"
          }
        }
      }
    },
    "tutorial.0.subtitle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学习每种棋子的移动规则"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn how each piece moves"
          }
        }
      }
    },
    "tutorial.0.description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "🔴 车走直线，可进可退\n🔴 马走日字，蹩脚不能跳\n🔴 象走田字，塞眼不能过\n🔴 炮翻山吃子，不吃子走直线\n🔴 兵卒过河可横移，不退\n🔴 士走斜线，不出九宫\n🔴 将帅不出宫，横竖一步\n\n点击棋子查看可走位置！"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "🔴 Rook moves in straight lines\n🔴 Knight moves in L-shape, blocked by adjacent pieces\n🔴 Bishop moves diagonally, blocked at center\n🔴 Cannon captures by jumping, moves straight otherwise\n🔴 Pawn can move sideways after crossing the river\n🔴 Advisor moves diagonally within the palace\n🔴 General moves one step within the palace\n\nTap a piece to see valid moves!"
          }
        }
      }
    },
    "tutorial.1.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将军与应将"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check and Respond"
          }
        }
      }
    },
    "tutorial.1.subtitle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学会被将军时如何应对"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn how to respond to check"
          }
        }
      }
    },
    "tutorial.1.description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⚡ 将军：对方走子后，你的将/帅被攻击\n\n应将方式：\n1️⃣ 逃跑：将/帅移到安全位置\n2️⃣ 挡住：用子力挡住攻击路线\n3️⃣ 吃子：吃掉将军的棋子\n\n⚠️ 不能不应将！必须解除将军状态。\n\nAI 将对你将军，尝试应将！"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⚡ Check: your General is under attack\n\nResponses:\n1️⃣ Flee: move General to safety\n2️⃣ Block: intercept the attack\n3️⃣ Capture: take the checking piece\n\n⚠️ You must respond to check!\n\nThe AI will check you — try to respond!"
          }
        }
      }
    },
    "tutorial.2.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将死判定"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkmate"
          }
        }
      }
    },
    "tutorial.2.subtitle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3 个一步杀练习"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3 one-move checkmate puzzles"
          }
        }
      }
    },
    "tutorial.2.description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "🏆 将死：将军且对方无法应将 = 获胜\n\n将死条件：\n• 被将军\n• 且无法逃跑、挡住、吃子\n\n尝试 3 个一步杀题目，\n找到致胜走法！"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "🏆 Checkmate: Check with no possible response = Win\n\nConditions:\n• Under check\n• Cannot flee, block, or capture\n\nTry 3 one-move checkmate puzzles!\nFind the winning move!"
          }
        }
      }
    },
    "tutorial.3.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "特殊规则"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Special Rules"
          }
        }
      }
    },
    "tutorial.3.subtitle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "困毙、长将、长捉"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stalemate, perpetual check, perpetual chase"
          }
        }
      }
    },
    "tutorial.3.description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ 困毙 = 输！（不是和棋）\n轮到走棋但无棋可走 = 判负\n\n🤝 长将和棋：连续将军，对方循环\n🤝 长捉和棋：连续捉子，循环不变\n\n💡 记住：困毙是输，不是和！"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Stalemate = Loss! (Not a draw)\nNo legal moves = Loss\n\n🤝 Perpetual check = Draw\n🤝 Perpetual chase = Draw\n\n💡 Remember: stalemate is a loss, not a draw!"
          }
        }
      }
    },
    "tutorial.4.title": {
      "localizations": {
        "zh-Hans": {
