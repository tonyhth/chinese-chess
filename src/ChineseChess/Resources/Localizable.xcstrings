    "tutorial.4.description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "🎮 实战时间！\n\n• 新手难度 AI\n• 关键局面会高亮推荐走法\n• 执红先行\n\n放手去下，享受对弈！"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "🎮 Game time!\n\n• Beginner AI\n• Key positions will highlight suggested moves\n• Red moves first\n\nEnjoy your first game!"
