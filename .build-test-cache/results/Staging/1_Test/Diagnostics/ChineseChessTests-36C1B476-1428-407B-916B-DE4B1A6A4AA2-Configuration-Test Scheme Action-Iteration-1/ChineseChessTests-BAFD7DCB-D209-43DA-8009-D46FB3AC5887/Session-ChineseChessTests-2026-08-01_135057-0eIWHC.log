                    get: { viewModel.perpetualCheckMessage != nil },
                    set: { if !$0 { viewModel.perpetualCheckMessage = nil } }
                )
            ) {
                Button(L10n.shared.t("common.gotIt")) { viewModel.perpetualCheckMessage = nil }
            } message: {
                Text(viewModel.perpetualCheckMessage ?? "")
            }
