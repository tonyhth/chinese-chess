                    set: { if !$0 { viewModel.engineFallbackMessage = nil } }
                )
            ) {
                Button(L10n.shared.t("common.ok")) { viewModel.engineFallbackMessage = nil }
            } message: {
                Text(viewModel.engineFallbackMessage ?? "")
            }
            // P0-1 fix: 长将判负首次触发解释弹窗
            .alert(
