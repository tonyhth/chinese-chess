        DataMigration.migrateGameHistoryToFiles()

        // P0-1 fix: 首次启动引导标志读取（在 onAppear 中触发弹窗）
        _firstLaunchNeeded = State(initialValue: !UserDefaults.standard.bool(forKey: "chinesechess.firstLaunchDialogShown"))
