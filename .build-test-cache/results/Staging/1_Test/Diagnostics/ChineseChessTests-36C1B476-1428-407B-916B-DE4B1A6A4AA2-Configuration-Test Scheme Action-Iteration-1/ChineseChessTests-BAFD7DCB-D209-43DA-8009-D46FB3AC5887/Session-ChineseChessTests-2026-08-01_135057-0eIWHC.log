                        Divider().frame(height: 24)

                        // 学棋组
                        Button(action: { activeSheet = .puzzles }) {
                            Image(systemName: "puzzlepiece")
                        }
                        .buttonStyle(.bordered)
                        .tint(.brown)
                        .help(L10n.shared.t("toolbar.puzzle"))
                        .keyboardShortcut("p", modifiers: [.command, .shift])

                        Button(action: {
                            activeSheet = .studyHub
