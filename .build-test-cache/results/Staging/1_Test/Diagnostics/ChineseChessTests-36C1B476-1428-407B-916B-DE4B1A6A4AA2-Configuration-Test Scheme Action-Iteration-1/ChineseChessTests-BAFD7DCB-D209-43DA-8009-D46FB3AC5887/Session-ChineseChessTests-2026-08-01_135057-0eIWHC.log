                isPresented: Binding(
                    get: { viewModel.perpetualChaseMessage != nil },
                    set: { if !$0 { viewModel.perpetualChaseMessage = nil } }
                )
            ) {
                Button(L10n.shared.t("common.gotIt")) { viewModel.perpetualChaseMessage = nil }
            } message: {
                Text(viewModel.perpetualChaseMessage ?? "")
            }
