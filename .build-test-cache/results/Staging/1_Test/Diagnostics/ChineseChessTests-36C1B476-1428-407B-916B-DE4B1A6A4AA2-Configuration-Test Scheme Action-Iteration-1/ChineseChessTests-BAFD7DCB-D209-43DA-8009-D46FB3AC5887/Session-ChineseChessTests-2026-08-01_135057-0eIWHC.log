                        .foregroundColor(.secondary)
                        .font(.subheadline)

                    Text("·")
                        .foregroundColor(.secondary)

                    Text(summary.difficulty?.displayName ?? "–")
                        .foregroundColor(.secondary)
                        .font(.subheadline)

