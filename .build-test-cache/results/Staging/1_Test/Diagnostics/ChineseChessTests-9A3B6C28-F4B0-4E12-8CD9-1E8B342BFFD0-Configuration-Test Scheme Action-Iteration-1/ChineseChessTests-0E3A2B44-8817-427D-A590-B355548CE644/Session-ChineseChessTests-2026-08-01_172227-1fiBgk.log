                            .navigationTitle(L10n.shared.t("toolbar.dailyChallenge"))
                            .toolbar {
                                ToolbarItem(placement: .confirmationAction) {
                                    Button(L10n.shared.t("common.done")) { activeSheet = nil }
                                }
                            }
                    }
