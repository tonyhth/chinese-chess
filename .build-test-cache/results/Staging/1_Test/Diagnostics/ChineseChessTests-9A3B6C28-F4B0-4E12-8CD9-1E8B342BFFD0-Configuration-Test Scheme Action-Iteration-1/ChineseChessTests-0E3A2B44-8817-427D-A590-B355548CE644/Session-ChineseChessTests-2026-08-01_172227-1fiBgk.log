                    }
                    .transition(.move(edge: .bottom).combined(with: .opacity))
                    .animation(.easeInOut(duration: 0.3), value: showReviewCard)
                }

                // P0-1 fix: 首次启动引导弹窗
                if showFirstLaunchDialog {
