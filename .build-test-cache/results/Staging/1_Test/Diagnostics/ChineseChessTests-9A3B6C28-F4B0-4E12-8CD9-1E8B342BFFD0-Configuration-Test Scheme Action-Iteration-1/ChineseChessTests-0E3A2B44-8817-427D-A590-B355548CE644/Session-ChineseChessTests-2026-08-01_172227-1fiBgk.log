        }
        .disabled(viewModel.record.moves.isEmpty)
    }

    // MARK: - 教练入口

    private var coachButton: some View {
        Button {
            showCoach = true
        } label: {
            Image(systemName: "graduationcap.fill")
                .foregroundColor(.white)
        }
        .disabled(viewModel.record.moves.isEmpty)
    }

